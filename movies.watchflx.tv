# Step 2: Extract base path per type
map $uri $secure_base_path {
    # Everything up to and including /hls/
    ~^(?P<base>.+/hls/)     $base;

    # Everything up to and including /original.mp4
    ~^(?P<base>.+/original\.mp4)    $base;

    # Fallback — use full URI
    default     $uri;
}


lua_shared_dict bw_counters 64m;  # shared across workers


# log_format bw_debug '$remote_addr - $arg_token - $body_bytes_sent - $request';

server {

    server_name movies.watchflx.tv;

    root /var/www/movies.watchflx.tv;
    index index.html;

    listen 443 ssl; # managed by Certbot
    ssl_certificate /etc/letsencrypt/live/movies.watchflx.tv/fullchain.pem; # managed by Certbot
    ssl_certificate_key /etc/letsencrypt/live/movies.watchflx.tv/privkey.pem; # managed by Certbot
    include /etc/letsencrypt/options-ssl-nginx.conf; # managed by Certbot
    ssl_dhparam /etc/letsencrypt/ssl-dhparams.pem; # managed by Certbot


    location /lua {
        content_by_lua_block {
            ngx.header.content_type = "text/plain"
            ngx.say("Lua is working")
        }
    }

    location /redis {
        content_by_lua_block {
            ngx.header.content_type = "text/plain"
            local redis = require "resty.redis"

            local red = redis:new()
            red:set_timeout(1000)

            local ok, err = red:connect("127.0.0.1", 6379)

            if not ok then
                ngx.say(err)
                return
            end

            local res, err = red:get("test")
            ngx.say(res)
        }
    }

    # Reverse proxy for MP4/m3u8/ts streaming
    location ~* \.(m3u8|ts)$ {
      include /etc/nginx/snippets/proxy-common.conf;
      
      # proxy_limit_rate 2m;
      limit_rate 1m;      
    }

    location ~* \.(mp4)$ {

      include /etc/nginx/snippets/proxy-common.conf;

      proxy_buffering off;
      proxy_request_buffering off;


    }

}
server {
    if ($host = movies.watchflx.tv) {
        return 301 https://$host$request_uri;
    } # managed by Certbot


    listen 80;
    server_name movies.watchflx.tv;
    return 404; # managed by Certbot


}





